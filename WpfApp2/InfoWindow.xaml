<Window x:Class="WpfApp2.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="InfoWindow" Height="450" Width="800">
    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Külön Window" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Ez az ablak egy kulon window vagy page vagy window" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,20"/>
            <TextBlock Text="Írd be a neved:" FontSize="14" FontWeight="Bold" Foreground="#1e293B" Margin="0,10,0,0"/>
            <TextBox x:Name="txtNev" Height="40" FontSize="16" Padding="8" Margin="0,10,0,25"/>
            <Button Content="Köszönés" Height="45" Margin="0,0,0,10" Click="koszones_click"/>
            <Button Content="Ablak bezárás" Height="45" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
