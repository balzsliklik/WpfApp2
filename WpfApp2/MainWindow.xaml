<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#1e293b">
            <StackPanel Margin="20">
                <TextBlock Text="WPF Navigation"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="bold"
                           Margin="0,10,0,30"/>
                <Button Content="Főoldal" Height="45"
                        Margin="0,0,0,10" Click="Home_click"/>
                <Button Content="Profil" Height="45"
                        Margin="0,0,0,25" Click="Profil_click"/>
                <TextBlock Text="Külön window" Foreground="White"
                           FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Új ablak - Show()"
                        Height="45" Margin="0,0,0,10" Click="Open_window_click"/>
                <Button Content="Modális - ShowDialog()"
                        Height="45" Margin="0,0,0,10" Click="OpenDialog_click"/>

            </StackPanel>
            
        </Border>
        <Frame Grid.Column="1" Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
