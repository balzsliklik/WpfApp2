<Page x:Class="WpfApp2.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage"
      Background="white">

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Profil" FontSize="32" FontWeight="Bold" Foreground="#1e293B"/>
            <TextBlock Text="Egy másik Page tartalma" FontSize="16" Foreground="#64748b" Margin=" 0,10,0,25"/>
            
            <TextBlock Text="Név" FontSize="16" FontWeight="Bold" Foreground="#1e293B"/>
            <TextBox x:Name="txtName" Height="40" FontSize="16" Padding="8"/>
            <TextBlock Text="Email" FontSize="16" FontWeight="Bold" Foreground="#1e293B" Margin="0,10,0,0"/>
            <TextBox x:Name="txtEmail" Height="40" FontSize="16" Padding="8" Margin="0,10,0,25"/>
            <Button Content="Adatok ellenőrzése" Height="45" Margin="0,0,0,10" FontSize="18" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Page>
